// Alt+P: определить выбранные данные и открыть окно переноса. Повторное нажатие в этом окне выполняет перенос.

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

	Окно = АктивноеОкно();
	Если Окно <> Неопределено И Окно.Содержимое.Количество() > 0
		И Окно.Содержимое[0].ИмяФормы = "ОбщаяФорма.WS_НастройкаОбмена" Тогда
		Окно.Содержимое[0].ВыполнитьПеренос();
		Возврат;
	КонецЕсли;

	Выбор =WS_КонтекстФормыКлиент.ПолучитьВыбор(ПараметрыВыполненияКоманды.Источник);
	Если Выбор.Значения.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Откройте объект или выделите строки в списке, затем нажмите Alt+P.");
		Возврат;
	КонецЕсли;

	Значения = Новый СписокЗначений;
	Значения.ЗагрузитьЗначения(Выбор.Значения);
	ОткрытьФорму("ОбщаяФорма.WS_НастройкаОбмена",
		Новый Структура("Выбор,Предупреждение", Значения, Выбор.Предупреждение), , Истина);

КонецПроцедуры
