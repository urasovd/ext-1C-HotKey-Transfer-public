// Определяет, что переносить, без привязки к именам конкретных форм и объектов конфигурации.

Функция ПолучитьВыбор(Источник = Неопределено) Экспорт

	Результат = Новый Структура("Значения,Предупреждение", Новый Массив, "");
	Форма = Источник;
	Если ТипЗнч(Форма) <> Тип("ФормаКлиентскогоПриложения") Тогда
		Окно = АктивноеОкно();
		Если Окно = Неопределено Или Окно.Содержимое.Количество() = 0 Тогда
			Возврат Результат;
		КонецЕсли;
		Форма = Окно.Содержимое[0];
	КонецЕсли;

	ДобавитьВыделенныеСтроки(Форма, Результат.Значения);
	Если Результат.Значения.Количество() = 0 Тогда
		Значение = СсылкаОбъектаФормы(Форма);
		Если ЗначениеЗаполнено(Значение) Тогда
			Результат.Значения.Добавить(Значение);
			Если Форма.Модифицированность Тогда
				Результат.Предупреждение = "Объект изменён, но не записан: будет перенесена записанная версия.";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Процедура ДобавитьВыделенныеСтроки(Форма, Значения)

	Таблица = Форма.ТекущийЭлемент;
	Если ТипЗнч(Таблица) <> Тип("ТаблицаФормы") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Строка Из Таблица.ВыделенныеСтроки Цикл
		Если ПодходитДляПереноса(Строка) Тогда
			Значения.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	Если Значения.Количество() = 0 И ПодходитДляПереноса(Таблица.ТекущаяСтрока) Тогда
		Значения.Добавить(Таблица.ТекущаяСтрока);
	КонецЕсли;

КонецПроцедуры

// Табличная часть объекта и обычные таблицы дают числовые идентификаторы строк,
// а группировка списка не передаётся на сервер. Остальное проверяет сервер.
Функция ПодходитДляПереноса(Значение)

	Возврат ЗначениеЗаполнено(Значение)
		И ТипЗнч(Значение) <> Тип("Число")
		И ТипЗнч(Значение) <> Тип("Строка")
		И ТипЗнч(Значение) <> Тип("СтрокаГруппировкиДинамическогоСписка");

КонецФункции

Функция СсылкаОбъектаФормы(Форма)

	Реквизиты = Новый Структура("Объект");
	ЗаполнитьЗначенияСвойств(Реквизиты, Форма);
	Значение = Неопределено;
	Если Реквизиты.Объект <> Неопределено И Реквизиты.Объект.Свойство("Ссылка", Значение)
		И ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	// Формы без реквизита «Объект» (например, физлица в ЗУП) открываются по ключу.
	Если Форма.Параметры.Свойство("Ключ", Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции
