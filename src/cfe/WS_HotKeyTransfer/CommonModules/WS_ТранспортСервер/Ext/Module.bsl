// Сторона источника: проверяет цель, собирает пакет и отправляет его. Пароли нигде не хранятся:
// запрос подписывается сохранённым хешем пароля текущего пользователя.

// Возвращает полный список того, что можно перенести. Поиск идёт только через объекты,
// которых нет на приёмнике: объекты, которые там уже есть, не показываются и не перезаписываются.
Функция Проверить(Выбор, Адрес, ПолеОбъекта = "") Экспорт

	Итог = Подготовить(Выбор, Адрес, ПолеОбъекта, Новый Массив).Итог;
	Если Итог.Успешно Тогда
		ДобавитьАдресВСписок(Адрес);
	КонецЕсли;
	Возврат Итог;

КонецФункции

// Снятые — ключи строк, с которых пользователь снял галочку. Записывается только отмеченное.
Функция Перенести(Выбор, Адрес, ПолеОбъекта = "", Причина = "", Снятые = Неопределено, СоздатьВерсии = Ложь) Экспорт

	Подготовка = Подготовить(Выбор, Адрес, ПолеОбъекта, ?(Снятые = Неопределено, Новый Массив, Снятые));
	Итог = Подготовка.Итог;
	Если НЕ Итог.Успешно Тогда
		Возврат Итог;
	КонецЕсли;
	Если Подготовка.Записываемые.Количество() = 0 Тогда
		ЗаполнитьОшибку(Итог, "WS_NOTHING_SELECTED", "Ничего не отмечено для переноса.");
		Возврат Итог;
	КонецЕсли;
	Если Подготовка.Неразрешённые.Количество() > 0 Или Подготовка.ЕстьБлокировки Тогда
		ЗаполнитьОшибку(Итог, "WS_PACKAGE_BLOCKED", "Данные изменились с момента проверки. Проверьте ещё раз.");
		Возврат Итог;
	КонецЕсли;
	Если Итог.Цель.Type = "production" И ПустаяСтрока(Причина) Тогда
		ЗаполнитьОшибку(Итог, "WS_REASON_REQUIRED", "Для рабочей базы укажите причину переноса.");
		Возврат Итог;
	КонецЕсли;

	Подготовка.СоздатьВерсии = СоздатьВерсии;
	Попытка
		Ответ = ВызватьОперацию(Подготовка, "apply", Причина, Подготовка.Записываемые);
		Если Ответ.Ok Тогда
			Итог.Записано = Истина;
			ЗапомнитьАдрес(Адрес);
		Иначе
			ЗаполнитьОшибку(Итог, Ответ.Code, Ответ.Error);
		КонецЕсли;
	Исключение
		ЗаполнитьОшибку(Итог, "WS_APPLY_CALL_FAILED", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Итог;

КонецФункции

// Поля-ссылки строки регистра: их можно выбрать вместо самой записи.
Функция ПоляСсылокРегистра(Выбор) Экспорт

	Поля = Новый Массив;
	Если Выбор.Количество() = 0 Или НЕ WS_СериализацияСервер.ЭтоКлючРегистраСведений(Выбор[0]) Тогда
		Возврат Поля;
	КонецЕсли;
	ТипыСсылок = WS_СериализацияСервер.ТипыСсылокПереноса();
	МетаданныеРегистра = Метаданные.НайтиПоТипу(ТипЗнч(Выбор[0]));
	Для Каждого Измерение Из МетаданныеРегистра.Измерения Цикл
		Для Каждого ТипИзмерения Из Измерение.Тип.Типы() Цикл
			Если ТипыСсылок.СодержитТип(ТипИзмерения) Тогда
				Поля.Добавить(Новый Структура("Имя,Представление", Измерение.Имя, Измерение.Синоним));
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если МетаданныеРегистра.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору Тогда
		Поля.Добавить(Новый Структура("Имя,Представление", "Регистратор", "Регистратор"));
	КонецЕсли;
	Возврат Поля;

КонецФункции

// Что переносить из строк регистра, если пользователь ещё не выбирал: объект из поля «Объект»,
// если оно есть (версии объектов, дополнительные сведения), иначе сами записи.
// Сделанный выбор запоминается для каждого регистра отдельно.
Функция ПолеОбъектаПоУмолчанию(Выбор, Поля) Экспорт

	Если Поля.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Сохранённое = ХранилищеОбщихНастроек.Загрузить("WS_HotKeyTransfer", КлючПоляОбъекта(Выбор));
	Если ТипЗнч(Сохранённое) = Тип("Строка") Тогда
		Если ПустаяСтрока(Сохранённое) Тогда
			Возврат "";
		КонецЕсли;
		Для Каждого Поле Из Поля Цикл
			Если Поле.Имя = Сохранённое Тогда
				Возврат Сохранённое;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Для Каждого Поле Из Поля Цикл
		Если Поле.Имя = "Объект" Тогда
			Возврат Поле.Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Процедура ЗапомнитьПолеОбъекта(Выбор, ПолеОбъекта) Экспорт

	Если Выбор.Количество() = 0 Или НЕ WS_СериализацияСервер.ЭтоКлючРегистраСведений(Выбор[0]) Тогда
		Возврат;
	КонецЕсли;
	Ключ = КлючПоляОбъекта(Выбор);
	Если ХранилищеОбщихНастроек.Загрузить("WS_HotKeyTransfer", Ключ) <> ПолеОбъекта Тогда
		ХранилищеОбщихНастроек.Сохранить("WS_HotKeyTransfer", Ключ, ПолеОбъекта);
	КонецЕсли;

КонецПроцедуры

Функция КлючПоляОбъекта(Выбор)

	Возврат "ПолеОбъекта|" + Метаданные.НайтиПоТипу(ТипЗнч(Выбор[0])).ПолноеИмя();

КонецФункции

// Флажок «Создать версии» запоминается у пользователя. По умолчанию включён.
Функция СоздаватьВерсии() Экспорт

	Значение = ХранилищеОбщихНастроек.Загрузить("WS_HotKeyTransfer", "СоздаватьВерсии");
	Возврат ?(ТипЗнч(Значение) = Тип("Булево"), Значение, Истина);

КонецФункции

Процедура ЗапомнитьСоздаватьВерсии(Значение) Экспорт

	ХранилищеОбщихНастроек.Сохранить("WS_HotKeyTransfer", "СоздаватьВерсии", Значение = Истина);

КонецПроцедуры

Функция ПолучитьАдреса() Экспорт

	Адреса = ХранилищеОбщихНастроек.Загрузить("WS_HotKeyTransfer", КлючАдресов());
	Возврат ?(ТипЗнч(Адреса) = Тип("Массив"), Адреса, Новый Массив);

КонецФункции

// Список привязан к базе: после переноса из рабочей базы в копию её адрес попал бы в бэкап,
// и новая копия предлагала бы перенос сама в себя.
Функция КлючАдресов() Экспорт

	Возврат "Адреса|" + WS_ОкружениеСервер.ПолучитьИдентификатор();

КонецФункции

// Адреса для поля «Куда»: сначала использованные этим пользователем, затем адрес рабочей базы.
Функция АдресаДляВыбора() Экспорт

	Адреса = ПолучитьАдреса();
	АдресРабочей = WS_ОкружениеСервер.АдресРабочейБазы();
	Если НЕ ПустаяСтрока(АдресРабочей) И WS_ОкружениеСервер.ПолучитьТипОкружения() <> "production"
		И Адреса.Найти(АдресРабочей) = Неопределено Тогда
		Адреса.Добавить(АдресРабочей);
	КонецЕсли;
	Возврат Адреса;

КонецФункции

// Возвращает текст ошибки или пустую строку. Адрес проверяется обращением к нему с сервера 1С,
// поэтому сохранится только адрес, по которому копии смогут выполнить перенос.
Функция СохранитьАдресРабочейБазы(Адрес) Экспорт

	Если НЕ ПравоДоступа("Администрирование", Метаданные) Тогда
		Возврат "Настройка доступна только пользователям с полными правами.";
	КонецЕсли;
	Если ПустаяСтрока(Адрес) Тогда
		WS_ОкружениеСервер.ЗаписатьАдресРабочейБазы("");
		Возврат "";
	КонецЕсли;

	Попытка
		Прокси = СоздатьПрокси(Адрес);
		Цель = WS_СериализацияСервер.СообщениеИзJSON(Прокси.ast_Handshake(""));
	Исключение
		Возврат ОбъяснитьОшибкуСвязи(ИнформацияОбОшибке());
	КонецПопытки;
	Если Цель.ConfigurationName <> Метаданные.Имя Тогда
		Возврат "По этому адресу другая конфигурация: " + Цель.ConfigurationName;
	КонецЕсли;
	Ошибка = WS_ОкружениеСервер.ОшибкаАдресаРабочейБазы(WS_ОкружениеСервер.ПолучитьТипОкружения(),
		WS_ОкружениеСервер.ПолучитьИдентификатор(), Цель.Type, Цель.Id);
	Если ПустаяСтрока(Ошибка) Тогда
		WS_ОкружениеСервер.ЗаписатьАдресРабочейБазы(СокрЛП(Адрес));
	КонецЕсли;
	Возврат Ошибка;

КонецФункции

Функция Подготовить(Выбор, Адрес, ПолеОбъекта, Снятые)

	Итог = Новый Структура("Успешно,КодОшибки,Ошибка,Предупреждение,Источник,ТипИсточника,Цель,Строки,Записано",
		Ложь, "", "", "", WS_ОкружениеСервер.ПолучитьИдентификатор(), WS_ОкружениеСервер.ПолучитьТипОкружения(),
		Неопределено, Новый Массив, Ложь);
	Подготовка = Новый Структура("Итог,Прокси,Записываемые,Разрешённые,Неразрешённые,ЕстьБлокировки,Время,СоздатьВерсии",
		Итог, Неопределено, Новый Массив, Снятые, Новый Массив, Ложь, "", Ложь);
	Попытка
		Если НЕ ПроверитьТекущегоПользователя(Итог) Тогда
			Возврат Подготовка;
		КонецЕсли;
		Подготовка.Прокси = СоздатьПрокси(Адрес);
		Если НЕ ВыполнитьHandshake(Подготовка) Тогда
			Возврат Подготовка;
		КонецЕсли;

		ТипыСсылок = WS_СериализацияСервер.ТипыСсылокПереноса();
		Новые = ЭлементыВыбора(Выбор, ПолеОбъекта, ТипыСсылок, Снятые);
		Если Новые.Количество() = 0 И Снятые.Количество() = 0 Тогда
			ЗаполнитьОшибку(Итог, "WS_NOTHING_SELECTED", "Выбранные строки нельзя перенести.");
			Возврат Подготовка;
		КонецЕсли;

		// Каждый уровень отправляет только новые элементы, поэтому уровни не повторяют уже проверенное.
		СтрокиПоКлючам = Новый Соответствие;
		Уровень = 1;
		Пока Новые.Количество() > 0 Цикл
			Ответ = ВызватьОперацию(Подготовка, "check", "", Новые);
			Если НЕ Ответ.Ok Тогда
				ЗаполнитьОшибку(Итог, Ответ.Code, Ответ.Error);
				Возврат Подготовка;
			КонецЕсли;
			ДобавитьСтрокиЭлементов(Подготовка, Новые, Ответ.Items, Уровень, СтрокиПоКлючам);
			Следующие = РазобратьОтсутствующие(Подготовка, Ответ.Missing, Уровень, ТипыСсылок, СтрокиПоКлючам);
			ДобавитьСвязи(Новые, СтрокиПоКлючам);
			Новые = Следующие;
			Уровень = Уровень + 1;
		КонецЦикла;
		Итог.Успешно = Истина;
	Исключение
		ЗаполнитьОшибку(Итог, "WS_PREPARE_FAILED", ОбъяснитьОшибкуСвязи(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Подготовка;

КонецФункции

Функция ПроверитьТекущегоПользователя(Итог)

	Если НЕ ПравоДоступа("Администрирование", Метаданные) Тогда
		ЗаполнитьОшибку(Итог, "WS_NOT_ADMIN", "Перенос доступен только пользователям с полными правами.");
		Возврат Ложь;
	КонецЕсли;
	Если ПустаяСтрока(ПользователиИнформационнойБазы.ТекущийПользователь().СохраняемоеЗначениеПароля) Тогда
		ЗаполнитьОшибку(Итог, "WS_NO_PASSWORD", "У вашего пользователя нет пароля 1С, поэтому приёмник не сможет его проверить.");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;

КонецФункции

Функция СоздатьПрокси(Адрес)

	Местоположение = АдресОписанияСервиса(Адрес);
	Защищённое = ?(НРег(Лев(Местоположение, 6)) = "https:", Новый ЗащищенноеСоединениеOpenSSL, Неопределено);
	Имя = WS_ОкружениеСервер.ИмяСлужебногоПользователя();
	Пароль = WS_ОкружениеСервер.ПарольСлужебногоПользователя();
	Если ПустаяСтрока(Пароль) Тогда
		ВызватьИсключение "В этой базе нет пароля служебного входа. Нажмите «Настройки» и укажите его или обновите базу из свежего бэкапа рабочей базы.";
	КонецЕсли;
	Определения = Новый WSОпределения(Местоположение, Имя, Пароль, , 30, Защищённое);
	Прокси = Новый WSПрокси(Определения, "1.1.1.1", "ast_WSObmen", "ast_WSObmenSoap", , 300, Защищённое);
	Прокси.Пользователь = Имя;
	Прокси.Пароль = Пароль;
	Возврат Прокси;

КонецФункции

Функция АдресОписанияСервиса(Адрес)

	Результат = СокрЛП(Адрес);
	Если СтрНайти(НРег(Результат), "wsdl") > 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Пока СтрЗаканчиваетсяНа(Результат, "/") Цикл
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЦикла;
	Возврат Результат + "/ws/ast_WSObmen?wsdl";

КонецФункции

Функция ВыполнитьHandshake(Подготовка)

	Итог = Подготовка.Итог;
	Ответ = WS_СериализацияСервер.СообщениеИзJSON(Подготовка.Прокси.ast_Handshake(""));
	Если Ответ.ProtocolVersion <> WS_ОкружениеСервер.ВерсияПротокола() Тогда
		ВерсияЦели = Неопределено;
		ЗаполнитьОшибку(Итог, "WS_PROTOCOL_UNSUPPORTED", СтрШаблон("Версии расширения несовместимы: здесь %1, на приёмнике %2. Обновите расширение.",
			WS_ОкружениеСервер.ВерсияРасширения(), ?(Ответ.Свойство("Version", ВерсияЦели), ВерсияЦели, "более старая")));
		Возврат Ложь;
	КонецЕсли;
	Если Ответ.Id = Итог.Источник Тогда
		ЗаполнитьОшибку(Итог, "WS_SAME_ENVIRONMENT", "Адрес указывает на эту же базу.");
		Возврат Ложь;
	КонецЕсли;
	Если Ответ.ConfigurationName <> Метаданные.Имя Тогда
		ЗаполнитьОшибку(Итог, "WS_CONFIGURATION_MISMATCH", "На приёмнике другая конфигурация: " + Ответ.ConfigurationName);
		Возврат Ложь;
	КонецЕсли;
	Итог.Цель = Ответ;
	Подготовка.Время = Ответ.ServerTime;
	Возврат Истина;

КонецФункции

Функция ЭлементыВыбора(Выбор, ПолеОбъекта, ТипыСсылок, Снятые)

	Если Выбор.Количество() > МаксимумЭлементов() Тогда
		ВызватьИсключение СтрШаблон("За один раз можно перенести не более %1 элементов.", МаксимумЭлементов());
	КонецЕсли;
	Элементы = Новый Массив;
	// Несколько строк регистра часто ссылаются на один объект, например версии одного документа:
	// объект попадает в пакет один раз.
	Добавленные = Новый Соответствие;
	Для Каждого Значение Из Выбор Цикл
		Элемент = Неопределено;
		Если WS_СериализацияСервер.ЭтоКлючРегистраСведений(Значение) И ПустаяСтрока(ПолеОбъекта) Тогда
			Элемент = WS_СериализацияСервер.СоздатьЭлементНабора(Значение, ТипыСсылок);
		Иначе
			Ссылка = ?(WS_СериализацияСервер.ЭтоКлючРегистраСведений(Значение), Значение[ПолеОбъекта], Значение);
			Если WS_СериализацияСервер.ЭтоСсылкаПереноса(Ссылка, ТипыСсылок) И НЕ Ссылка.Пустая() Тогда
				Элемент = WS_СериализацияСервер.СоздатьЭлементОбъекта(Ссылка, ТипыСсылок);
			КонецЕсли;
		КонецЕсли;
		Если Элемент = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Ключ = WS_СериализацияСервер.КлючСсылки(Элемент);
		Если Снятые.Найти(Ключ) = Неопределено И Добавленные[Ключ] = Неопределено Тогда
			Добавленные.Вставить(Ключ, Истина);
			Элементы.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	Возврат Элементы;

КонецФункции

Процедура ДобавитьСтрокиЭлементов(Подготовка, Элементы, Результаты, Уровень, СтрокиПоКлючам)

	Для Индекс = 0 По Элементы.ВГраница() Цикл
		Элемент = Элементы[Индекс];
		Результат = Результаты[Индекс];
		ДобавитьСтроку(Подготовка.Итог, СтрокиПоКлючам, WS_СериализацияСервер.КлючСсылки(Элемент), Элемент.Presentation,
			Элемент.Related, Результат.Action, СтрСоединить(Результат.Changes, ", "), Результат.Message, Уровень);
		Подготовка.Записываемые.Добавить(Элемент);
		Подготовка.ЕстьБлокировки = Подготовка.ЕстьБлокировки Или Результат.Action = "blocked";
	КонецЦикла;

КонецПроцедуры

// Возвращает элементы следующего уровня. На лимитах поиск останавливается с предупреждением,
// а не с ошибкой: уже найденное остаётся в списке.
Функция РазобратьОтсутствующие(Подготовка, Отсутствующие, Уровень, ТипыСсылок, СтрокиПоКлючам)

	Итог = Подготовка.Итог;
	Следующие = Новый Массив;
	Для Каждого ОписаниеСсылки Из Отсутствующие Цикл
		Ключ = WS_СериализацияСервер.КлючСсылки(ОписаниеСсылки);
		Если СтрокиПоКлючам[Ключ] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Снята = Подготовка.Разрешённые.Найти(Ключ) <> Неопределено;
		ТипСсылки = ИзXMLТипа(ОписаниеСсылки.Type, "");
		Ссылка = XMLЗначение(ТипСсылки, ОписаниеСсылки.Uuid);
		Если Ссылка.ПолучитьОбъект() = Неопределено Тогда
			// Ссылка битая уже в источнике: перенести нечего, разрешаем её оставить.
			ДобавитьСтроку(Итог, СтрокиПоКлючам, Ключ, ОписаниеСсылки.Presentation, Истина, "broken", "", "", Уровень + 1);
			Если НЕ Снята Тогда
				Подготовка.Разрешённые.Добавить(Ключ);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если Снята Тогда
			Продолжить;
		КонецЕсли;
		ВсегоНайдено = Подготовка.Записываемые.Количество() + Следующие.Количество();
		Если Уровень >= МаксимумУровнейСвязей() Или ВсегоНайдено >= МаксимумЭлементов() Тогда
			ДобавитьСтроку(Итог, СтрокиПоКлючам, Ключ, ОписаниеСсылки.Presentation, Истина, "limit", "", "", Уровень + 1);
			Подготовка.Неразрешённые.Добавить(Ключ);
			Итог.Предупреждение = СтрШаблон("Поиск связанных объектов остановлен на лимите (%1 объектов, %2 уровней).",
				МаксимумЭлементов(), МаксимумУровнейСвязей());
			Продолжить;
		КонецЕсли;
		Элемент = WS_СериализацияСервер.СоздатьЭлементОбъекта(Ссылка, ТипыСсылок, Истина);
		Следующие.Добавить(Элемент);
		// Заглушка не даёт добавить объект дважды, пока он ждёт проверки на следующем уровне.
		СтрокиПоКлючам.Вставить(Ключ, НоваяСтрока(Ключ, Элемент.Presentation, Истина, "", "", "", Уровень + 1));
	КонецЦикла;
	Возврат Следующие;

КонецФункции

Процедура ДобавитьСвязи(Элементы, СтрокиПоКлючам)

	Для Каждого Элемент Из Элементы Цикл
		КлючЭлемента = WS_СериализацияСервер.КлючСсылки(Элемент);
		ДобавитьСвязиСсылок(Элемент.Refs, КлючЭлемента, Ложь, СтрокиПоКлючам);
		ДобавитьСвязиСсылок(Элемент.MovementRefs, КлючЭлемента, Истина, СтрокиПоКлючам);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьСвязиСсылок(Ссылки, КлючРодителя, ВДвижениях, СтрокиПоКлючам)

	Для Каждого ОписаниеСсылки Из Ссылки Цикл
		СтрокаСсылки = СтрокиПоКлючам[WS_СериализацияСервер.КлючСсылки(ОписаниеСсылки)];
		Если СтрокаСсылки <> Неопределено Тогда
			СтрокаСсылки.Parents.Добавить(Новый Структура("Key,InMovements", КлючРодителя, ВДвижениях));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьСтроку(Итог, СтрокиПоКлючам, Ключ, Представление, Связанный, Действие, Изменения, Сообщение, Уровень)

	СтрокаСписка = СтрокиПоКлючам[Ключ];
	Если СтрокаСписка = Неопределено Тогда
		СтрокаСписка = НоваяСтрока(Ключ, Представление, Связанный, Действие, Изменения, Сообщение, Уровень);
		СтрокиПоКлючам.Вставить(Ключ, СтрокаСписка);
	Иначе
		СтрокаСписка.Action = Действие;
		СтрокаСписка.Changes = Изменения;
		СтрокаСписка.Message = Сообщение;
	КонецЕсли;
	Итог.Строки.Добавить(СтрокаСписка);

КонецПроцедуры

Функция НоваяСтрока(Ключ, Представление, Связанный, Действие, Изменения, Сообщение, Уровень)

	Возврат Новый Структура("Key,Presentation,Related,Action,Changes,Message,Level,Parents",
		Ключ, Представление, Связанный, Действие, Изменения, Сообщение, Уровень, Новый Массив);

КонецФункции

Функция ВызватьОперацию(Подготовка, Операция, Причина, Элементы)

	// CreateVersions читают приёмники с версии 1.3.0, более старые его пропускают.
	Тело = WS_СериализацияСервер.СообщениеВJSON(Новый Структура("Items,AllowedMissing,CreateVersions",
		Элементы, Подготовка.Разрешённые, Подготовка.СоздатьВерсии));
	Пользователь =ПользователиИнформационнойБазы.ТекущийПользователь();
	Цель = Подготовка.Итог.Цель.Id;
	Подпись = WS_СериализацияСервер.ПодписьЗапроса(Пользователь.СохраняемоеЗначениеПароля,
		Операция, Пользователь.Имя, Цель, Подготовка.Время, Тело);
	Запрос = WS_СериализацияСервер.СообщениеВJSON(Новый Структура(
		"ProtocolVersion,User,Source,Target,Time,Reason,Signature,Body",
		WS_ОкружениеСервер.ВерсияПротокола(), Пользователь.Имя, Подготовка.Итог.Источник, Цель,
		Подготовка.Время, Причина, Подпись, Тело));
	Если Операция = "apply" Тогда
		Возврат WS_СериализацияСервер.СообщениеИзJSON(Подготовка.Прокси.ast_Apply(Запрос));
	КонецЕсли;
	Возврат WS_СериализацияСервер.СообщениеИзJSON(Подготовка.Прокси.ast_Check(Запрос));

КонецФункции

Функция ОбъяснитьОшибкуСвязи(Информация)

	Текст = КраткоеПредставлениеОшибки(Информация);
	Если СтрНайти(Текст, "401") > 0 Или СтрНайти(НРег(Текст), "unauthorized") > 0
		Или СтрНайти(НРег(Текст), "аутентификаци") > 0 Тогда
		Возврат "База по этому адресу не пустила служебный вход: там не включён приём или другой пароль служебного входа. Проверьте «Настройки» в обеих базах.";
	КонецЕсли;
	Возврат Текст;

КонецФункции

// Проверка только добавляет адрес в конец списка. Первым становится адрес последнего переноса:
// его поле «Куда» подставляет при открытии, и проверка не должна менять эту базу.
Процедура ДобавитьАдресВСписок(Адрес)

	Адреса = ПолучитьАдреса();
	Если Адреса.Найти(СокрЛП(Адрес)) = Неопределено Тогда
		Адреса.Добавить(СокрЛП(Адрес));
		ХранилищеОбщихНастроек.Сохранить("WS_HotKeyTransfer", КлючАдресов(), Адреса);
	КонецЕсли;

КонецПроцедуры

Процедура ЗапомнитьАдрес(Адрес)

	Адреса = ПолучитьАдреса();
	Индекс = Адреса.Найти(СокрЛП(Адрес));
	Если Индекс <> Неопределено Тогда
		Адреса.Удалить(Индекс);
	КонецЕсли;
	Адреса.Вставить(0, СокрЛП(Адрес));
	ХранилищеОбщихНастроек.Сохранить("WS_HotKeyTransfer", КлючАдресов(), Адреса);

КонецПроцедуры

Процедура ЗаполнитьОшибку(Итог, Код, Текст)

	Итог.Успешно = Ложь;
	Итог.КодОшибки = Код;
	Итог.Ошибка = Текст;
	ЗаписьЖурналаРегистрации("WS_HotKeyTransfer.Send", УровеньЖурналаРегистрации.Предупреждение, , ,
		"[" + Код + "] " + Текст);

КонецПроцедуры

Функция МаксимумЭлементов()

	Возврат 200;

КонецФункции

Функция МаксимумУровнейСвязей()

	Возврат 10;

КонецФункции
