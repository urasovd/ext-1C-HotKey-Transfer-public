// Идентичность базы берётся из строки соединения, поэтому копия из бэкапа её не наследует.

Функция ВерсияПротокола() Экспорт

	Возврат 3;

КонецФункции

// Единственный источник номера версии — свойство Версия в Configuration.xml расширения.
Функция ВерсияРасширения() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Расширения = РасширенияКонфигурации.Получить(Новый Структура("Имя", "WS_HotKeyTransfer"));
	Возврат ?(Расширения.Количество() = 0, "", Расширения[0].Версия);

КонецФункции

Функция ПолучитьИдентификатор() Экспорт

	Части = РазобратьСтрокуСоединения();
	Если Части["ref"] <> Неопределено Тогда
		Возврат Части["srvr"] + "/" + Части["ref"];
	КонецЕсли;
	Возврат Части["file"];

КонецФункции

// Всё, что не похоже на копию по имени базы, считается рабочей базой: ошибка здесь безопасна,
// потому что приводит лишь к лишнему подтверждению.
Функция ПолучитьТипОкружения() Экспорт

	Части = РазобратьСтрокуСоединения();
	ИмяБазы = ?(Части["ref"] <> Неопределено, Части["ref"], Части["file"]);
	Возврат ?(ЭтоИмяКопии(ИмяБазы), "test", "production");

КонецФункции

// Признак должен быть отдельным словом: base_dev и copy01 — копии, а devices и kopeyka — нет.
Функция ЭтоИмяКопии(ИмяБазы) Экспорт

	Путь = СтрЗаменить(НРег(ИмяБазы), "\", "/");
	Части = СтрРазделить(Путь, "/", Ложь);
	Слова = ?(Части.Количество() = 0, "", Части[Части.ВГраница()]);
	Для Каждого Разделитель Из СтрРазделить("_,-,., ", ",") Цикл
		Слова = СтрЗаменить(Слова, Разделитель, ",");
	КонецЦикла;
	Признаки = СтрРазделить("dev,test,copy,тест,копия", ",");
	Для Каждого Слово Из СтрРазделить(Слова, ",", Ложь) Цикл
		Пока СтрДлина(Слово) > 0 И СтрНайти("0123456789", Прав(Слово, 1)) > 0 Цикл
			Слово = Лев(Слово, СтрДлина(Слово) - 1);
		КонецЦикла;
		Если Признаки.Найти(Слово) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ПолучитьИнформацию() Экспорт

	Возврат Новый Структура("Id,Type,ConfigurationName,ConfigurationVersion,Version",
		ПолучитьИдентификатор(), ПолучитьТипОкружения(), Метаданные.Имя, Метаданные.Версия, ВерсияРасширения());

КонецФункции

// Адрес рабочей базы хранится в данных базы, а не у пользователя, поэтому попадает в бэкап
// и сразу доступен всем пользователям копии.
Функция АдресРабочейБазы() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Адрес = ХранилищеОбщихНастроек.Загрузить("WS_HotKeyTransfer", "АдресРабочейБазы", , ИмяСлужебногоПользователя());
	Возврат ?(ТипЗнч(Адрес) = Тип("Строка"), Адрес, "");

КонецФункции

Процедура ЗаписатьАдресРабочейБазы(Адрес) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить("WS_HotKeyTransfer", "АдресРабочейБазы", Адрес, , ИмяСлужебногоПользователя());

КонецПроцедуры

// В рабочей базе указывают её собственный адрес, в копии — адрес рабочей базы.
// Так копия не предложит перенос в саму себя или в другую рабочую базу.
Функция ОшибкаАдресаРабочейБазы(ТипЭтойБазы, ИдЭтойБазы, ТипЦели, ИдЦели) Экспорт

	Если ТипЭтойБазы = "production" Тогда
		Если ИдЦели <> ИдЭтойБазы Тогда
			Возврат "Это рабочая база, укажите её собственный адрес. По этому адресу другая база: " + ИдЦели;
		КонецЕсли;
	ИначеЕсли ТипЦели <> "production" Тогда
		Возврат "По этому адресу не рабочая база: " + ИдЦели;
	КонецЕсли;
	Возврат "";

КонецФункции

// Служебный вход только открывает доступ к операциям веб-сервиса и не даёт других прав:
// разрешение на запись выдаёт подпись запроса хешем пароля пользователя в WS_ПриёмникСервер.
// Удаление этого пользователя выключает приём.
Функция ИмяСлужебногоПользователя() Экспорт

	Возврат "WS_HotKeyTransfer";

КонецФункции

// Пароль хранится в данных базы и попадает в бэкап, поэтому рабочая база и её копии знают
// один и тот же пароль, и перенос работает в обе стороны. Новых объектов метаданных не нужно.
Функция ПарольСлужебногоПользователя() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Пароль = ХранилищеОбщихНастроек.Загрузить("WS_HotKeyTransfer", "ПарольВхода", , ИмяСлужебногоПользователя());
	Возврат ?(ТипЗнч(Пароль) = Тип("Строка"), Пароль, "");

КонецФункции

// Запоминает пароль и применяет его к служебному пользователю, если он уже создан.
Процедура УстановитьПарольСлужебногоВхода(Пароль) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	// Показанный пароль остаётся в поле настроек. Повторная запись нарушила бы запрет
	// на недавно использованные пароли, и адрес рядом с ним не сохранился бы.
	Если Пароль = ПарольСлужебногоПользователя() Тогда
		Возврат;
	КонецЕсли;
	// Сначала пользователь: пароль может не пройти требования базы, и тогда ничего не сохранится.
	Пользователь = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяСлужебногоПользователя());
	Если Пользователь <> Неопределено Тогда
		Пользователь.Пароль = Пароль;
		Пользователь.Записать();
	КонецЕсли;
	ХранилищеОбщихНастроек.Сохранить("WS_HotKeyTransfer", "ПарольВхода", Пароль, , ИмяСлужебногоПользователя());

КонецПроцедуры

// Суффикс нужен, чтобы пароль прошёл требование сложности, если оно включено в базе.
Процедура СоздатьНовыйПарольСлужебногоВхода() Экспорт

	Случайная = СтрЗаменить(Строка(Новый УникальныйИдентификатор) + Строка(Новый УникальныйИдентификатор), "-", "");
	УстановитьПарольСлужебногоВхода(Случайная + "-Hk1");

КонецПроцедуры

Функция ПриёмВключён() Экспорт

	Возврат ПользователиИнформационнойБазы.НайтиПоИмени(ИмяСлужебногоПользователя()) <> Неопределено;

КонецФункции

Процедура ВключитьПриём() Экспорт

	Пользователь = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяСлужебногоПользователя());
	Если ПустаяСтрока(ПарольСлужебногоПользователя()) Тогда
		СоздатьНовыйПарольСлужебногоВхода();
	КонецЕсли;
	Если Пользователь = Неопределено Тогда
		Пользователь = ПользователиИнформационнойБазы.СоздатьПользователя();
		Пользователь.Имя = ИмяСлужебногоПользователя();
		Пользователь.ПолноеИмя = "Перенос данных (служебный вход)";
		Пользователь.АутентификацияСтандартная = Истина;
		Пользователь.Пароль = ПарольСлужебногоПользователя();
		Пользователь.ЗапрещеноИзменятьПароль = Истина;
		Пользователь.ПоказыватьВСпискеВыбора = Ложь;
		Пользователь.Роли.Добавить(Метаданные.Роли.WS_ОсновнаяРоль);
		Пользователь.Записать();
	КонецЕсли;
	СвязатьСоСправочникомПользователей(Пользователь);

КонецПроцедуры

// Служебный пользователь мог остаться от прежней версии, где он не попал в справочник.
// Без этой записи БСП не открывает сеанс, и приём не работает.
Функция ПриёмНастроенПолностью() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Пользователь = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяСлужебногоПользователя());
	Если Пользователь = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Менеджер = МенеджерСправочникаПользователей();
	Возврат Менеджер = Неопределено
		Или НЕ Менеджер.НайтиПоРеквизиту("ИдентификаторПользователяИБ", Пользователь.УникальныйИдентификатор).Пустая();

КонецФункции

// В конфигурациях без справочника «Пользователи» в стиле БСП возвращает Неопределено.
Функция МенеджерСправочникаПользователей()

	МетаданныеСправочника = Метаданные.Справочники.Найти("Пользователи");
	Если МетаданныеСправочника = Неопределено
		Или МетаданныеСправочника.Реквизиты.Найти("ИдентификаторПользователяИБ") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Справочники[МетаданныеСправочника.Имя];

КонецФункции

// БСП не открывает сеанс пользователю, которого нет в справочнике «Пользователи».
// В конфигурациях без такого справочника ничего делать не нужно.
Процедура СвязатьСоСправочникомПользователей(Пользователь)

	Менеджер = МенеджерСправочникаПользователей();
	Если Менеджер = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Менеджер.НайтиПоРеквизиту("ИдентификаторПользователяИБ", Пользователь.УникальныйИдентификатор).Пустая() Тогда
		Возврат;
	КонецЕсли;
	МетаданныеСправочника = Метаданные.Справочники.Пользователи;
	Элемент = Менеджер.СоздатьЭлемент();
	Элемент.Наименование = Пользователь.ПолноеИмя;
	Элемент.ИдентификаторПользователяИБ = Пользователь.УникальныйИдентификатор;
	Если МетаданныеСправочника.Реквизиты.Найти("Служебный") <> Неопределено Тогда
		Элемент.Служебный = Истина;
	КонецЕсли;
	Элемент.ОбменДанными.Загрузка = Истина;
	Элемент.Записать();

КонецПроцедуры

Функция РазобратьСтрокуСоединения()

	Части = Новый Соответствие;
	Для Каждого ЧастьСтроки Из СтрРазделить(СтрокаСоединенияИнформационнойБазы(), ";", Ложь) Цикл
		Позиция = СтрНайти(ЧастьСтроки, "=");
		Если Позиция > 0 Тогда
			Значение = СтрЗаменить(СокрЛП(Сред(ЧастьСтроки, Позиция + 1)), """", "");
			Части.Вставить(НРег(СокрЛП(Лев(ЧастьСтроки, Позиция - 1))), НРег(Значение));
		КонецЕсли;
	КонецЦикла;
	Возврат Части;

КонецФункции
