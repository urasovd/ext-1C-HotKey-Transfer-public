// Сборка элементов пакета и формат обмена. Транспорт и запись здесь не выполняются.

Функция СериализоватьВJSON(Значение) Экспорт

	Если Значение = Неопределено Тогда
		ВызватьИсключение "Нельзя сериализовать неопределённое значение.";
	КонецЕсли;

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(, Символы.Таб));
	СериализаторXDTO.ЗаписатьJSON(ЗаписьJSON, Значение, НазначениеТипаXML.Явное);
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

Функция ПрочитатьИзJSON(СтрокаJSON) Экспорт

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	Значение = СериализаторXDTO.ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	Возврат Значение;

КонецФункции

Функция СообщениеВJSON(Сообщение) Экспорт

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Сообщение);
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

Функция СообщениеИзJSON(СтрокаJSON) Экспорт

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	Значение = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	Возврат Значение;

КонецФункции

Функция ХешСтроки(ЗначениеСтроки) Экспорт

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Строка(ЗначениеСтроки));
	Возврат Base64Строка(Хеширование.ХешСумма);

КонецФункции

// Одна и та же формула на обеих сторонах: совпадение доказывает, что у источника
// тот же хеш пароля этого пользователя, что и у приёмника.
Функция ПодписьЗапроса(ХешПароля, Операция, Пользователь, Цель, Время, ТелоЗапроса) Экспорт

	Возврат ХешСтроки(ХешПароля + "|" + Операция + "|" + Пользователь + "|" + Цель + "|" + Время
		+ "|" + ХешСтроки(ТелоЗапроса));

КонецФункции

Функция ЭтоСсылкаПереноса(Значение, ТипыСсылок = Неопределено) Экспорт

	Если ТипыСсылок = Неопределено Тогда
		ТипыСсылок = ТипыСсылокПереноса();
	КонецЕсли;
	Возврат Значение <> Неопределено И ТипыСсылок.СодержитТип(ТипЗнч(Значение));

КонецФункции

Функция ТипыСсылокПереноса() Экспорт

	Типы = Новый Массив;
	Менеджеры = Новый Массив;
	Менеджеры.Добавить(Справочники);
	Менеджеры.Добавить(Документы);
	Менеджеры.Добавить(ПланыВидовХарактеристик);
	Менеджеры.Добавить(ПланыСчетов);
	Менеджеры.Добавить(ПланыВидовРасчета);
	Менеджеры.Добавить(БизнесПроцессы);
	Менеджеры.Добавить(Задачи);
	Для Каждого Менеджер Из Менеджеры Цикл
		Для Каждого ТипСсылки Из Менеджер.ТипВсеСсылки().Типы() Цикл
			Типы.Добавить(ТипСсылки);
		КонецЦикла;
	КонецЦикла;
	Возврат Новый ОписаниеТипов(Типы);

КонецФункции

Функция ЭтоКлючРегистраСведений(Значение) Экспорт

	МетаданныеЗначения = Метаданные.НайтиПоТипу(ТипЗнч(Значение));
	Возврат МетаданныеЗначения <> Неопределено
		И Метаданные.РегистрыСведений.Содержит(МетаданныеЗначения);

КонецФункции

Функция КлючСсылки(ОписаниеСсылки) Экспорт

	Возврат ОписаниеСсылки.Type + "/" + ОписаниеСсылки.Uuid;

КонецФункции

// Что открыть по строке окна переноса: объект этой базы или выбранную запись регистра.
// Неопределено, если такого объекта в этой базе нет.
Функция ЗначениеПоКлючу(Ключ, Выбор) Экспорт

	Разделитель = СтрНайти(Ключ, "/");
	ИмяТипа = Лев(Ключ, Разделитель - 1);
	Идентификатор = Сред(Ключ, Разделитель + 1);

	Для Каждого Значение Из Выбор Цикл
		Если ЭтоКлючРегистраСведений(Значение)
			И Метаданные.НайтиПоТипу(ТипЗнч(Значение)).ПолноеИмя() = ИмяТипа
			И ХешКлючаЗаписи(Значение) = Идентификатор Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;

	Тип = ИзXMLТипа(ИмяТипа, "");
	Если Тип = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ссылка = XMLЗначение(Тип, Идентификатор);
	Возврат ?(Ссылка.ПолучитьОбъект() = Неопределено, Неопределено, Ссылка);

КонецФункции

Функция ХешКлючаЗаписи(КлючЗаписи)

	Возврат ХешСтроки(ЗначениеВСтрокуВнутр(КлючЗаписи));

КонецФункции

// Описание ссылки в пакете не зависит от языка конфигурации и работает, даже если
// на приёмнике такого типа нет.
Функция ОписаниеСсылки(Ссылка) Экспорт

	Возврат Новый Структура("Type,Uuid,Presentation",
		XMLТипЗнч(Ссылка).ИмяТипа, XMLСтрока(Ссылка), Строка(Ссылка));

КонецФункции

Функция СоздатьЭлементОбъекта(Ссылка, ТипыСсылок, Связанный = Ложь) Экспорт

	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		ВызватьИсключение "Объект не найден в этой базе: " + Строка(Ссылка);
	КонецЕсли;
	МетаданныеОбъекта = Ссылка.Метаданные();

	Ссылки = Новый Соответствие;
	ДобавитьСсылкиОбъекта(Объект, МетаданныеОбъекта, Ссылки, ТипыСсылок);

	Движения = Новый Массив;
	СсылкиДвижений = Новый Соответствие;
	Если Метаданные.Документы.Содержит(МетаданныеОбъекта) Тогда
		Для Каждого НаборДвижений Из Объект.Движения Цикл
			НаборДвижений.Прочитать();
			ДобавитьСсылкиТаблицы(НаборДвижений.Выгрузить(), СсылкиДвижений, ТипыСсылок, Ссылка);
			Движения.Добавить(СериализоватьВJSON(НаборДвижений));
		КонецЦикла;
	КонецЕсли;

	Элемент = НовыйЭлемент("Object", МетаданныеОбъекта.ПолноеИмя(), Строка(Ссылка), Связанный);
	Элемент.Type = XMLТипЗнч(Ссылка).ИмяТипа;
	Элемент.Uuid = XMLСтрока(Ссылка);
	Элемент.Payload = СериализоватьВJSON(Объект);
	Элемент.Movements = Движения;
	Элемент.Refs = МассивСсылок(Ссылки);
	Элемент.MovementRefs = МассивСсылок(СсылкиДвижений);
	Возврат Элемент;

КонецФункции

Функция СоздатьЭлементНабора(КлючЗаписи, ТипыСсылок) Экспорт

	МетаданныеРегистра = Метаданные.НайтиПоТипу(ТипЗнч(КлючЗаписи));
	Набор = РегистрыСведений[МетаданныеРегистра.Имя].СоздатьНаборЗаписей();
	Если МетаданныеРегистра.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору Тогда
		Набор.Отбор.Регистратор.Установить(КлючЗаписи.Регистратор);
	Иначе
		Если МетаданныеРегистра.ПериодичностьРегистраСведений
			<> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
			Набор.Отбор.Период.Установить(КлючЗаписи.Период);
		КонецЕсли;
		Для Каждого Измерение Из МетаданныеРегистра.Измерения Цикл
			Набор.Отбор[Измерение.Имя].Установить(КлючЗаписи[Измерение.Имя]);
		КонецЦикла;
	КонецЕсли;
	Набор.Прочитать();

	Ссылки = Новый Соответствие;
	ДобавитьСсылкиТаблицы(Набор.Выгрузить(), Ссылки, ТипыСсылок);

	Части = Новый Массив;
	Для Каждого ЭлементОтбора Из Набор.Отбор Цикл
		Если ЭлементОтбора.Использование Тогда
			Части.Добавить(Строка(ЭлементОтбора.Значение));
		КонецЕсли;
	КонецЦикла;
	Представление = МетаданныеРегистра.Представление() + ": " + СтрСоединить(Части, ", ");
	Элемент = НовыйЭлемент("RecordSet", МетаданныеРегистра.ПолноеИмя(), Представление, Ложь);
	Элемент.Type = МетаданныеРегистра.ПолноеИмя();
	Элемент.Uuid = ХешКлючаЗаписи(КлючЗаписи);
	Элемент.Payload = СериализоватьВJSON(Набор);
	Элемент.Refs = МассивСсылок(Ссылки);
	Возврат Элемент;

КонецФункции

Функция НовыйЭлемент(Вид, ИмяМетаданных, Представление, Связанный)

	Возврат Новый Структура("Kind,Name,Type,Uuid,Presentation,Related,Payload,Movements,Refs,MovementRefs",
		Вид, ИмяМетаданных, "", "", Представление, Связанный, "", Новый Массив, Новый Массив, Новый Массив);

КонецФункции

Процедура ДобавитьСсылкиОбъекта(Объект, МетаданныеОбъекта, Ссылки, ТипыСсылок)

	Для Каждого Реквизит Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
		// Не все стандартные реквизиты являются свойствами объекта: такие останутся пустыми.
		Значения = Новый Структура(Реквизит.Имя);
		ЗаполнитьЗначенияСвойств(Значения, Объект);
		ДобавитьСсылку(Значения[Реквизит.Имя], Ссылки, ТипыСсылок, Объект.Ссылка);
	КонецЦикла;
	Для Каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл
		ДобавитьСсылку(Объект[Реквизит.Имя], Ссылки, ТипыСсылок, Объект.Ссылка);
	КонецЦикла;
	Для Каждого ТабличнаяЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
		ДобавитьСсылкиТаблицы(Объект[ТабличнаяЧасть.Имя].Выгрузить(), Ссылки, ТипыСсылок, Объект.Ссылка);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьСсылкиТаблицы(Таблица, Ссылки, ТипыСсылок, СамаСсылка = Неопределено)

	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Для Каждого Колонка Из Таблица.Колонки Цикл
			ДобавитьСсылку(СтрокаТаблицы[Колонка.Имя], Ссылки, ТипыСсылок, СамаСсылка);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьСсылку(Значение, Ссылки, ТипыСсылок, СамаСсылка)

	Если НЕ ЭтоСсылкаПереноса(Значение, ТипыСсылок) Или Значение.Пустая() Или Значение = СамаСсылка Тогда
		Возврат;
	КонецЕсли;
	Ссылки.Вставить(Значение, Истина);

КонецПроцедуры

Функция МассивСсылок(Ссылки)

	Результат = Новый Массив;
	Для Каждого Элемент Из Ссылки Цикл
		Результат.Добавить(ОписаниеСсылки(Элемент.Ключ));
	КонецЦикла;
	Возврат Результат;

КонецФункции
