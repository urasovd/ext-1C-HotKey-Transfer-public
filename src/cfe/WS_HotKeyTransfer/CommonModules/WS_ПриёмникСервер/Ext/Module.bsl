// Приёмник. Запрос приходит под служебным входом без прав на данные, поэтому операции идут в привилегированном
// режиме, а решение о доступе принимается здесь по подписи и полным правам названного пользователя.

Функция ВыполнитьHandshake() Экспорт

	Ответ = WS_ОкружениеСервер.ПолучитьИнформацию();
	Ответ.Вставить("ProtocolVersion", WS_ОкружениеСервер.ВерсияПротокола());
	Ответ.Вставить("ServerTime", XMLСтрока(ТекущаяДатаСеанса()));
	Возврат WS_СериализацияСервер.СообщениеВJSON(Ответ);

КонецФункции

Функция ПроверитьПакет(ТекстЗапроса) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Ответ = НовыйОтвет();
	Попытка
		Запрос = РазобратьЗапрос(ТекстЗапроса, "check", Ответ);
		Если Запрос <> Неопределено Тогда
			ЗаполнитьПроверку(WS_СериализацияСервер.СообщениеИзJSON(Запрос.Body), Ответ);
			Ответ.Ok = Истина;
		КонецЕсли;
	Исключение
		ЗаполнитьОшибку(Ответ, "WS_CHECK_FAILED", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Ошибка, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат WS_СериализацияСервер.СообщениеВJSON(Ответ);

КонецФункции

Функция ПрименитьПакет(ТекстЗапроса) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Ответ = НовыйОтвет();
	Попытка
		Запрос = РазобратьЗапрос(ТекстЗапроса, "apply", Ответ);
		Если Запрос = Неопределено Тогда
			Возврат WS_СериализацияСервер.СообщениеВJSON(Ответ);
		КонецЕсли;
		Тело = WS_СериализацияСервер.СообщениеИзJSON(Запрос.Body);
		ЗаполнитьПроверку(Тело, Ответ);
		ОставитьНеразрешённые(Ответ, Тело.AllowedMissing);
		Если Ответ.Missing.Количество() > 0 Или ЕстьНесовместимые(Ответ) Тогда
			ЗаполнитьОшибку(Ответ, "WS_PACKAGE_BLOCKED", "Пакет не прошёл проверку на приёмнике, ничего не записано.");
			Возврат WS_СериализацияСервер.СообщениеВJSON(Ответ);
		КонецЕсли;

		Версии = ПараметрыВерсий(Запрос, Тело);
		НачатьТранзакцию();
		Попытка
			Записанные = Новый Массив;
			Для Каждого Элемент Из Тело.Items Цикл
				Записанные.Добавить(ЗаписатьЗначение(Элемент.Payload, Версии));
				Для Каждого Движение Из Элемент.Movements Цикл
					ЗаписатьЗначение(Движение);
				КонецЦикла;
			КонецЦикла;
			// Версии создаются, когда записан весь пакет: данные версии содержат представления
			// ссылок, а связанные объекты из пакета до этого момента ещё не существуют.
			Если Версии <> Неопределено Тогда
				Для Каждого Значение Из Записанные Цикл
					Если ЭтоОбъектСоСсылкой(Значение) Тогда
						СоздатьВерсию(Значение, Версии);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;

		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Информация, ТекстЖурнала(Запрос, Тело, Ответ));
		Ответ.Ok = Истина;
	Исключение
		ЗаполнитьОшибку(Ответ, "WS_APPLY_FAILED", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Ошибка, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат WS_СериализацияСервер.СообщениеВJSON(Ответ);

КонецФункции

Функция РазобратьЗапрос(ТекстЗапроса, Операция, Ответ)

	Запрос = WS_СериализацияСервер.СообщениеИзJSON(ТекстЗапроса);
	Если Запрос.ProtocolVersion <> WS_ОкружениеСервер.ВерсияПротокола() Тогда
		ЗаполнитьОшибку(Ответ, "WS_PROTOCOL_UNSUPPORTED", "Версии расширения в базах различаются. Обновите расширение.");
		Возврат Неопределено;
	КонецЕсли;
	Если Запрос.Target <> WS_ОкружениеСервер.ПолучитьИдентификатор() Тогда
		ЗаполнитьОшибку(Ответ, "WS_TARGET_MISMATCH", "Запрос предназначен другой базе.");
		Возврат Неопределено;
	КонецЕсли;
	Если Макс(XMLЗначение(Тип("Дата"), Запрос.Time) - ТекущаяДатаСеанса(),
		ТекущаяДатаСеанса() - XMLЗначение(Тип("Дата"), Запрос.Time)) > 600 Тогда
		ЗаполнитьОшибку(Ответ, "WS_REQUEST_EXPIRED", "Запрос устарел. Повторите проверку.");
		Возврат Неопределено;
	КонецЕсли;

	Пользователь = ПользователиИнформационнойБазы.НайтиПоИмени(Запрос.User);
	Если Пользователь <> Неопределено
		И НЕ ПустаяСтрока(Пользователь.СохраняемоеЗначениеПароля)
		И ПравоДоступа("Администрирование", Метаданные, Пользователь)
		И Запрос.Signature = WS_СериализацияСервер.ПодписьЗапроса(Пользователь.СохраняемоеЗначениеПароля,
			Операция, Запрос.User, Запрос.Target, Запрос.Time, Запрос.Body) Тогда
		Возврат Запрос;
	КонецЕсли;

	ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Предупреждение, "Отклонён запрос пользователя " + Запрос.User
		+ " из " + Запрос.Source);
	ЗаполнитьОшибку(Ответ, "WS_ACCESS_DENIED", "Перенос запрещён: пользователь " + Запрос.User
		+ " должен быть в обеих базах с тем же паролем и полными правами.");
	Возврат Неопределено;

КонецФункции

Процедура ЗаполнитьПроверку(Тело, Ответ)

	ВПакете = Новый Соответствие;
	Для Каждого Элемент Из Тело.Items Цикл
		ВПакете.Вставить(WS_СериализацияСервер.КлючСсылки(Элемент), Истина);
		Ответ.Items.Добавить(ПроверитьЭлемент(Элемент));
	КонецЦикла;

	// Ссылки проверяются группами по типу: один запрос на тип, а не на каждую ссылку.
	ПоТипам = Новый Соответствие;
	Для Каждого Элемент Из Тело.Items Цикл
		СгруппироватьСсылки(Элемент.Refs, ВПакете, ПоТипам);
		СгруппироватьСсылки(Элемент.MovementRefs, ВПакете, ПоТипам);
	КонецЦикла;

	Для Каждого ГруппаСсылок Из ПоТипам Цикл
		ДобавитьОтсутствующие(ГруппаСсылок.Ключ, ГруппаСсылок.Значение, Ответ.Missing);
	КонецЦикла;

КонецПроцедуры

Процедура СгруппироватьСсылки(Ссылки, Учтённые, ПоТипам)

	Для Каждого ОписаниеСсылки Из Ссылки Цикл
		Ключ = WS_СериализацияСервер.КлючСсылки(ОписаниеСсылки);
		Если Учтённые[Ключ] = Истина Тогда
			Продолжить;
		КонецЕсли;
		Учтённые.Вставить(Ключ, Истина);
		Если ПоТипам[ОписаниеСсылки.Type] = Неопределено Тогда
			ПоТипам.Вставить(ОписаниеСсылки.Type, Новый Массив);
		КонецЕсли;
		ПоТипам[ОписаниеСсылки.Type].Добавить(ОписаниеСсылки);
	КонецЦикла;

КонецПроцедуры

Функция ПроверитьЭлемент(Элемент)

	Результат = Новый Структура("Presentation,Related,Action,Message,Changes",
		Элемент.Presentation, Элемент.Related, "", "", Новый Массив);
	МетаданныеЭлемента = Метаданные.НайтиПоПолномуИмени(Элемент.Name);
	Если МетаданныеЭлемента = Неопределено Тогда
		Результат.Action = "blocked";
		Результат.Message = "На приёмнике нет объекта метаданных " + Элемент.Name;
		Возврат Результат;
	КонецЕсли;

	Попытка
		Значение = WS_СериализацияСервер.ПрочитатьИзJSON(Элемент.Payload);
		Движения = Новый Массив;
		Для Каждого Движение Из Элемент.Movements Цикл
			Движения.Добавить(WS_СериализацияСервер.ПрочитатьИзJSON(Движение));
		КонецЦикла;
		Если Элемент.Kind = "Object" Тогда
			Ссылка = XMLЗначение(ИзXMLТипа(Элемент.Type, ""), Элемент.Uuid);
			Существующий = Ссылка.ПолучитьОбъект();
			Если Существующий = Неопределено Тогда
				Результат.Action = "create";
			Иначе
				Результат.Changes = ИзмененияОбъекта(МетаданныеЭлемента, Значение, Существующий, Движения);
			КонецЕсли;
		Иначе
			Результат.Changes = ИзмененияНабора(МетаданныеЭлемента, Значение, Результат);
		КонецЕсли;
	Исключение
		Результат.Action = "blocked";
		Результат.Message = "Структура данных отличается: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Если ПустаяСтрока(Результат.Action) Тогда
		Результат.Action = ?(Результат.Changes.Количество() = 0, "unchanged", "update");
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Значения сравниваются на приёмнике, поэтому ссылки совпадают по UUID, а не по представлению.
Функция ИзмененияОбъекта(МетаданныеОбъекта, Значение, Существующий, Движения)

	Изменения = Новый Массив;
	Служебные = СтрРазделить("Ссылка,ВерсияДанных,Предопределенный,ИмяПредопределенныхДанных", ",");
	Для Каждого Реквизит Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
		Если Служебные.Найти(Реквизит.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Новое = Новый Структура(Реквизит.Имя);
		Прежнее = Новый Структура(Реквизит.Имя);
		ЗаполнитьЗначенияСвойств(Новое, Значение);
		ЗаполнитьЗначенияСвойств(Прежнее, Существующий);
		Если НЕ ЗначенияРавны(Новое[Реквизит.Имя], Прежнее[Реквизит.Имя]) Тогда
			Изменения.Добавить(Реквизит.Представление());
		КонецЕсли;
	КонецЦикла;
	Для Каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл
		Если НЕ ЗначенияРавны(Значение[Реквизит.Имя], Существующий[Реквизит.Имя]) Тогда
			Изменения.Добавить(Реквизит.Представление());
		КонецЕсли;
	КонецЦикла;
	Для Каждого ТабличнаяЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
		Если НЕ ТаблицыРавны(Значение[ТабличнаяЧасть.Имя].Выгрузить(), Существующий[ТабличнаяЧасть.Имя].Выгрузить()) Тогда
			Изменения.Добавить(ТабличнаяЧасть.Представление());
		КонецЕсли;
	КонецЦикла;
	Для Каждого Набор Из Движения Цикл
		ПрежнийНабор = Существующий.Движения[Набор.Метаданные().Имя];
		ПрежнийНабор.Прочитать();
		Если НЕ ТаблицыРавны(Набор.Выгрузить(), ПрежнийНабор.Выгрузить()) Тогда
			Изменения.Добавить("движения: " + Набор.Метаданные().Представление());
		КонецЕсли;
	КонецЦикла;
	Возврат Изменения;

КонецФункции

Функция ИзмененияНабора(МетаданныеРегистра, Набор, Результат)

	Изменения = Новый Массив;
	Прежний = РегистрыСведений[МетаданныеРегистра.Имя].СоздатьНаборЗаписей();
	Для Каждого ЭлементОтбора Из Набор.Отбор Цикл
		Если ЭлементОтбора.Использование Тогда
			Прежний.Отбор[ЭлементОтбора.Имя].Установить(ЭлементОтбора.Значение);
		КонецЕсли;
	КонецЦикла;
	Прежний.Прочитать();
	Если Прежний.Количество() = 0 Тогда
		Результат.Action = "create";
	ИначеЕсли НЕ ТаблицыРавны(Набор.Выгрузить(), Прежний.Выгрузить()) Тогда
		Изменения.Добавить("записи регистра");
	КонецЕсли;
	Возврат Изменения;

КонецФункции

Функция ТаблицыРавны(Первая, Вторая)

	Если Первая.Количество() <> Вторая.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 0 По Первая.Количество() - 1 Цикл
		Для Каждого Колонка Из Первая.Колонки Цикл
			Если НЕ ЗначенияРавны(Первая[Индекс][Колонка.Имя], Вторая[Индекс][Колонка.Имя]) Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ЗначенияРавны(Первое, Второе)

	Если ТипЗнч(Первое) = Тип("ХранилищеЗначения") И ТипЗнч(Второе) = Тип("ХранилищеЗначения") Тогда
		Возврат XMLСтрока(Первое) = XMLСтрока(Второе);
	КонецЕсли;
	Возврат Первое = Второе;

КонецФункции

Процедура ДобавитьОтсутствующие(ИмяТипа, ОписанияСсылок, Отсутствующие)

	ТипСсылки = ИзXMLТипа(ИмяТипа, "");
	МетаданныеТипа = ?(ТипСсылки = Неопределено, Неопределено, Метаданные.НайтиПоТипу(ТипСсылки));
	Если МетаданныеТипа = Неопределено Тогда
		Для Каждого ОписаниеСсылки Из ОписанияСсылок Цикл
			Отсутствующие.Добавить(ОписаниеСсылки);
		КонецЦикла;
		Возврат;
	КонецЕсли;

	Ссылки = Новый Массив;
	Для Каждого ОписаниеСсылки Из ОписанияСсылок Цикл
		Ссылки.Добавить(XMLЗначение(ТипСсылки, ОписаниеСсылки.Uuid));
	КонецЦикла;
	Запрос = Новый Запрос("ВЫБРАТЬ Т.Ссылка ИЗ " + МетаданныеТипа.ПолноеИмя() + " КАК Т ГДЕ Т.Ссылка В (&Ссылки)");
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Найденные = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

	Для Индекс = 0 По Ссылки.ВГраница() Цикл
		Если Найденные.Найти(Ссылки[Индекс]) = Неопределено Тогда
			Отсутствующие.Добавить(ОписанияСсылок[Индекс]);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Битая ссылка допустима, только если пользователь явно снял галочку с этого объекта.
Процедура ОставитьНеразрешённые(Ответ, Разрешённые)

	Оставшиеся = Новый Массив;
	Для Каждого ОписаниеСсылки Из Ответ.Missing Цикл
		Если Разрешённые.Найти(WS_СериализацияСервер.КлючСсылки(ОписаниеСсылки)) = Неопределено Тогда
			Оставшиеся.Добавить(ОписаниеСсылки);
		КонецЕсли;
	КонецЦикла;
	Ответ.Missing = Оставшиеся;

КонецПроцедуры

Функция ЕстьНесовместимые(Ответ)

	Для Каждого Элемент Из Ответ.Items Цикл
		Если Элемент.Action = "blocked" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Версии — Неопределено или параметры версий объектов, см. ПараметрыВерсий.
// Возвращает записанное значение.
Функция ЗаписатьЗначение(Сериализованное, Версии = Неопределено)

	Значение = WS_СериализацияСервер.ПрочитатьИзJSON(Сериализованное);
	Значение.ОбменДанными.Загрузка = Истина;
	// Прежнее состояние существующего объекта сохраняется в его последнюю версию до записи.
	// В режиме загрузки БСП делает только это и новую версию не создаёт.
	Если Версии <> Неопределено И ЭтоОбъектСоСсылкой(Значение) И ОбъектЕсть(Значение) Тогда
		Версии.Модуль.ЗаписатьВерсиюОбъекта(Значение, РежимЗаписиВерсии(Значение));
	КонецЕсли;
	Значение.Записать();
	Возврат Значение;

КонецФункции

// Внутри транзакции ПолучитьОбъект() по несуществующей ссылке вызывает ошибку,
// поэтому наличие объекта проверяется запросом.
Функция ОбъектЕсть(Объект)

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 ИСТИНА ИЗ " + Объект.Метаданные().ПолноеИмя() + " КАК Т ГДЕ Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

Функция РежимЗаписиВерсии(Объект)

	Возврат ?(Метаданные.Документы.Содержит(Объект.Метаданные()), РежимЗаписиДокумента.Запись, Ложь);

КонецФункции

// Запись идёт в режиме загрузки, и БСП в этом режиме версию не создаёт. Поэтому версия
// создаётся штатной процедурой БСП с настоящим автором и причиной в комментарии.
// Если версионирование для этого вида объектов не включено, БСП ничего не запишет.
Функция ПараметрыВерсий(Запрос, Тело)

	Если НЕ Тело.Свойство("CreateVersions") Или Тело.CreateVersions <> Истина
		Или Метаданные.ОбщиеМодули.Найти("ВерсионированиеОбъектов") = Неопределено
		Или Метаданные.ФункциональныеОпции.Найти("ИспользоватьВерсионированиеОбъектов") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьВерсионированиеОбъектов") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Комментарий = "Перенос из " + Запрос.Source + ". Пользователь: " + Запрос.User
		+ ?(ПустаяСтрока(Запрос.Reason), "", ". Причина: " + Запрос.Reason);
	Возврат Новый Структура("Модуль,Автор,Комментарий", Вычислить("ВерсионированиеОбъектов"),
		WS_ОкружениеСервер.ЭлементСправочникаПользователей(Запрос.User), Комментарий);

КонецФункции

Процедура СоздатьВерсию(Объект, Версии)

	Объект.ОбменДанными.Загрузка = Ложь;
	Объект.ДополнительныеСвойства.Вставить("ВерсионированиеОбъектовКомментарийКВерсии", Версии.Комментарий);
	Если Версии.Автор <> Неопределено Тогда
		Объект.ДополнительныеСвойства.Вставить("АвторВерсии", Версии.Автор);
	КонецЕсли;
	Версии.Модуль.ЗаписатьВерсиюОбъекта(Объект, РежимЗаписиВерсии(Объект));

КонецПроцедуры

Функция ЭтоОбъектСоСсылкой(Значение)

	МетаданныеЗначения = Метаданные.НайтиПоТипу(ТипЗнч(Значение));
	Возврат МетаданныеЗначения <> Неопределено
		И (Метаданные.Справочники.Содержит(МетаданныеЗначения)
		Или Метаданные.Документы.Содержит(МетаданныеЗначения)
		Или Метаданные.ПланыВидовХарактеристик.Содержит(МетаданныеЗначения)
		Или Метаданные.ПланыСчетов.Содержит(МетаданныеЗначения)
		Или Метаданные.ПланыВидовРасчета.Содержит(МетаданныеЗначения)
		Или Метаданные.БизнесПроцессы.Содержит(МетаданныеЗначения)
		Или Метаданные.Задачи.Содержит(МетаданныеЗначения));

КонецФункции

// Записи идут под служебным входом, поэтому автор и состав сохраняются здесь.
Функция ТекстЖурнала(Запрос, Тело, Ответ)

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("Пользователь: %1. Источник: %2. Причина: %3. Элементов: %4.",
		Запрос.User, Запрос.Source, Запрос.Reason, Тело.Items.Количество()));
	Для Индекс = 0 По Тело.Items.ВГраница() Цикл
		Элемент = Тело.Items[Индекс];
		Строки.Добавить(СтрШаблон("%1: %2 [%3 %4] %5", Ответ.Items[Индекс].Action, Элемент.Presentation,
			Элемент.Name, Элемент.Uuid, СтрСоединить(Ответ.Items[Индекс].Changes, ", ")));
	КонецЦикла;
	Для Каждого Ключ Из Тело.AllowedMissing Цикл
		Строки.Добавить("Оставлена ссылка без объекта: " + Ключ);
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция НовыйОтвет()

	Возврат Новый Структура("Ok,Code,Error,Items,Missing", Ложь, "", "", Новый Массив, Новый Массив);

КонецФункции

Процедура ЗаполнитьОшибку(Ответ, Код, Текст)

	Ответ.Ok = Ложь;
	Ответ.Code = Код;
	Ответ.Error = Текст;

КонецПроцедуры

Процедура ЗаписатьВЖурнал(Уровень, Текст)

	ЗаписьЖурналаРегистрации("WS_HotKeyTransfer.Receive", Уровень, , , Текст);

КонецПроцедуры
