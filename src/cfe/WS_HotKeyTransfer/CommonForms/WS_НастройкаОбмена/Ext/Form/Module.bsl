&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Выбор.ЗагрузитьЗначения(Параметры.Выбор.ВыгрузитьЗначения());
	Заголовок = СтрШаблон("Перенос: %1 (версия %2)", ПредставлениеВыбора(), WS_ОкружениеСервер.ВерсияРасширения());

	ЗаполнитьАдреса();

	Поля = WS_ТранспортСервер.ПоляСсылокРегистра(Выбор.ВыгрузитьЗначения());
	Элементы.ПолеОбъекта.Видимость = Поля.Количество() > 0;
	// Пустое значение означает сами записи. Без подсказки поле выглядит незаполненным,
	// и не видно, что можно перенести объекты из поля, например документы из версий объектов.
	Элементы.ПолеОбъекта.РежимВыбораИзСписка = Истина;
	Элементы.ПолеОбъекта.РедактированиеТекста = Ложь;
	Элементы.ПолеОбъекта.ПодсказкаВвода = "Записи регистра";
	Элементы.ПолеОбъекта.СписокВыбора.Добавить("", "Записи регистра");
	Для Каждого Поле Из Поля Цикл
		Элементы.ПолеОбъекта.СписокВыбора.Добавить(Поле.Имя, "Объект из поля: " + Поле.Представление);
	КонецЦикла;
	ПолеОбъекта = WS_ТранспортСервер.ПолеОбъектаПоУмолчанию(Выбор.ВыгрузитьЗначения(), Поля);

	Элементы.Настройки.Видимость = ПравоДоступа("Администрирование", Метаданные);
	Элементы.ТаблицаСтрок.ОтборСтрок = Новый ФиксированнаяСтруктура("Виден", Истина);
	Состояние = Параметры.Предупреждение;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ОбновитьСписок();
	Если НЕ ПустаяСтрока(Адрес) Тогда
		ПодключитьОбработчикОжидания("ПроверитьПриОткрытии", 0.1, Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПриОткрытии()

	ВыполнитьПроверку(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ПараметрыПриИзменении(Элемент)

	ВыполнитьПроверку(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОбработка(Команда)

	ВыполнитьПроверку(Истина);

КонецПроцедуры

// Галочки обрабатываются без обращения к приёмнику: весь список уже получен при проверке.
&НаКлиенте
Процедура ТаблицаСтрокОтмеченПриИзменении(Элемент)

	ТекущаяСтрока = Элементы.ТаблицаСтрок.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено И НЕ МожноОтметить(ТекущаяСтрока.Действие) Тогда
		ТекущаяСтрока.Отмечен = Ложь;
	КонецЕсли;
	ОбновитьСписок();

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСтрокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле = Элементы.ТаблицаСтрокОтмечен Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	ОткрытьОбъектСтроки(Строки.НайтиПоИдентификатору(ВыбраннаяСтрока));

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОбъектОбработка(Команда)

	ОткрытьОбъектСтроки(Элементы.ТаблицаСтрок.ТекущиеДанные);

КонецПроцедуры

// Открывается объект этой базы, то есть то, что будет перенесено.
&НаКлиенте
Процедура ОткрытьОбъектСтроки(СтрокаСписка)

	Если СтрокаСписка = Неопределено Тогда
		Состояние = "Выберите строку в списке.";
		Возврат;
	КонецЕсли;
	Значение = ЗначениеСтроки(СтрокаСписка.Ключ);
	Если Значение = Неопределено Тогда
		Состояние = "Этого объекта нет в этой базе: " + СтрокаСписка.Представление;
		Возврат;
	КонецЕсли;
	ПоказатьЗначение(, Значение);

КонецПроцедуры

&НаСервере
Функция ЗначениеСтроки(Ключ)

	Возврат WS_СериализацияСервер.ЗначениеПоКлючу(Ключ, Выбор.ВыгрузитьЗначения());

КонецФункции

&НаКлиенте
Процедура СнятьСвязанныеОбработка(Команда)

	Для Каждого СтрокаСписка Из Строки Цикл
		Если СтрокаСписка.Связанный Тогда
			СтрокаСписка.Отмечен = Ложь;
		КонецЕсли;
	КонецЦикла;
	ОбновитьСписок();

КонецПроцедуры

&НаКлиенте
Процедура ПеренестиОбработка(Команда)

	ВыполнитьПеренос();

КонецПроцедуры

// Вызывается и кнопкой, и повторным Alt+P из общей команды.
&НаКлиенте
Процедура ВыполнитьПеренос() Экспорт

	Если НЕ Элементы.Перенести.Доступность Тогда
		Возврат;
	КонецЕсли;
	Если НЕ РабочаяБаза Тогда
		ЗаписатьНаПриёмник();
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(Причина)) Тогда
		ТекущийЭлемент = Элементы.Причина;
		Состояние = "Для рабочей базы укажите причину переноса.";
		Возврат;
	КонецЕсли;
	Вопрос = "Записать данные в РАБОЧУЮ базу " + ИмяЦели + "?" + Символы.ПС + Сводка;
	ПоказатьВопрос(Новый ОписаниеОповещения("ПослеПодтверждения", ЭтотОбъект),
		Вопрос, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтверждения(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаписатьНаПриёмник();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НастройкиОбработка(Команда)

	ОткрытьФорму("ОбщаяФорма.WS_НастройкиПереноса", , ЭтотОбъект, , , ,
		Новый ОписаниеОповещения("ПослеНастроек", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ПослеНастроек(Результат, ДополнительныеПараметры) Экспорт

	БылАдрес = НЕ ПустаяСтрока(Адрес);
	ЗаполнитьАдреса();
	Если НЕ БылАдрес И НЕ ПустаяСтрока(Адрес) Тогда
		ВыполнитьПроверку(Ложь);
	КонецЕсли;

КонецПроцедуры

// Поле «Куда» остаётся как есть, если адрес уже указан: настройка не должна его подменять.
&НаСервере
Процедура ЗаполнитьАдреса()

	Элементы.Адрес.СписокВыбора.Очистить();
	Для Каждого СохранённыйАдрес Из WS_ТранспортСервер.АдресаДляВыбора() Цикл
		Элементы.Адрес.СписокВыбора.Добавить(СохранённыйАдрес);
	КонецЦикла;
	Если ПустаяСтрока(Адрес) И Элементы.Адрес.СписокВыбора.Количество() > 0 Тогда
		Адрес = Элементы.Адрес.СписокВыбора[0].Значение;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПроверку(СохранитьОтметки)

	ПроверитьНаСервере(СохранитьОтметки);
	ОбновитьСписок();
	Если Элементы.Перенести.Доступность Тогда
		ТекущийЭлемент = Элементы.Перенести;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьНаПриёмник()

	Снятые = Новый Массив;
	Для Каждого СтрокаСписка Из Строки Цикл
		Если НЕ СтрокаСписка.Отмечен Тогда
			Снятые.Добавить(СтрокаСписка.Ключ);
		КонецЕсли;
	КонецЦикла;
	ПеренестиНаСервере(Снятые);
	ОбновитьСписок();

КонецПроцедуры

&НаСервере
Процедура ПроверитьНаСервере(СохранитьОтметки)

	ПроверкаПройдена = Ложь;
	Записано = Ложь;
	ПрежниеОтметки = Новый Соответствие;
	Если СохранитьОтметки Тогда
		Для Каждого СтрокаСписка Из Строки Цикл
			ПрежниеОтметки.Вставить(СтрокаСписка.Ключ, СтрокаСписка.Отмечен);
		КонецЦикла;
	КонецЕсли;
	Строки.Очистить();

	Если ПустаяСтрока(Адрес) Тогда
		Состояние = "Укажите адрес базы-приёмника, например http://сервер/база";
		Возврат;
	КонецЕсли;

	Если Элементы.ПолеОбъекта.Видимость Тогда
		WS_ТранспортСервер.ЗапомнитьПолеОбъекта(Выбор.ВыгрузитьЗначения(), ПолеОбъекта);
	КонецЕсли;
	Итог = WS_ТранспортСервер.Проверить(Выбор.ВыгрузитьЗначения(), Адрес, ПолеОбъекта);
	Для Каждого Данные Из Итог.Строки Цикл
		НоваяСтрока = Строки.Добавить();
		НоваяСтрока.Ключ = Данные.Key;
		НоваяСтрока.Представление = Данные.Presentation;
		НоваяСтрока.Связанный = Данные.Related;
		НоваяСтрока.Действие = Данные.Action;
		НоваяСтрока.Изменения = Данные.Changes;
		НоваяСтрока.Сообщение = Данные.Message;
		НоваяСтрока.Уровень = Данные.Level;
		НоваяСтрока.Родители = СвязиСтрокой(Данные.Parents);
		НоваяСтрока.Отмечен = Данные.Action = "create" Или Данные.Action = "update";
		Если ПрежниеОтметки[Данные.Key] <> Неопределено И МожноОтметить(Данные.Action) Тогда
			НоваяСтрока.Отмечен = ПрежниеОтметки[Данные.Key];
		КонецЕсли;
	КонецЦикла;

	Если Итог.Успешно Тогда
		ЗаполнитьАдреса();
	КонецЕсли;
	ПоказатьНаправление(Итог);
	ПроверкаПройдена = Итог.Успешно;
	Состояние = ?(Итог.Успешно, Итог.Предупреждение, Итог.Ошибка);

КонецПроцедуры

&НаСервере
Процедура ПеренестиНаСервере(Снятые)

	Итог = WS_ТранспортСервер.Перенести(Выбор.ВыгрузитьЗначения(), Адрес, ПолеОбъекта, СокрЛП(Причина), Снятые);
	Записано = Итог.Записано;
	Состояние = ?(Записано, "Готово: данные записаны.", Итог.Ошибка);

КонецПроцедуры

&НаСервере
Процедура ПоказатьНаправление(Итог)

	РабочаяБаза = Итог.Цель <> Неопределено И Итог.Цель.Type = "production";
	ИмяЦели = ?(Итог.Цель = Неопределено, "", Итог.Цель.Id);
	ИзРабочей = Итог.ТипИсточника = "production";
	Направление = ?(ИзРабочей, "ИЗ РАБОЧЕЙ БАЗЫ ", "") + Итог.Источник + " → "
		+ ?(ПустаяСтрока(ИмяЦели), "?", ИмяЦели) + ?(РабочаяБаза, " (РАБОЧАЯ БАЗА)", "");
	Элементы.Направление.ЦветТекста = ?(РабочаяБаза Или ИзРабочей, WebЦвета.Красный, Новый Цвет);
	Элементы.Причина.Видимость = РабочаяБаза;

КонецПроцедуры

// Показывает только нужные строки и пересчитывает подписи и итог по текущим галочкам.
&НаКлиенте
Процедура ОбновитьСписок()

	Связи = РазобратьСвязи();
	ОтметитьВидимые(Связи);

	Создать = 0;
	Обновить = 0;
	БитыхСсылок = 0;
	Для Каждого СтрокаСписка Из Строки Цикл
		СтрокаСписка.Что = ОтступУровня(СтрокаСписка.Уровень) + СтрокаСписка.Представление;
		Если НЕ СтрокаСписка.Виден Тогда
			Продолжить;
		КонецЕсли;
		СтрокаСписка.Результат = ТекстРезультата(СтрокаСписка, Связи);
		Если СтрокаСписка.Отмечен Тогда
			Создать = Создать + ?(СтрокаСписка.Действие = "create", 1, 0);
			Обновить = Обновить + ?(СтрокаСписка.Действие = "create", 0, 1);
		ИначеЕсли СтрокаСписка.Связанный Тогда
			БитыхСсылок = БитыхСсылок + 1;
		КонецЕсли;
	КонецЦикла;

	Всего = Создать + Обновить;
	Сводка = СтрШаблон("Будет записано: %1 (создать %2, обновить %3)", Всего, Создать, Обновить)
		+ ?(БитыхСсылок > 0, СтрШаблон(". Битых ссылок: %1", БитыхСсылок), "");
	Элементы.Перенести.Доступность = ПроверкаПройдена И НЕ Записано И Всего > 0;
	Элементы.СнятьСвязанные.Видимость = ПроверкаПройдена;

КонецПроцедуры

&НаКлиенте
Функция РазобратьСвязи()

	Связи = Новый Соответствие;
	Для Каждого СтрокаСписка Из Строки Цикл
		Связи.Вставить(СтрокаСписка.Ключ, СтрокаСписка);
	КонецЦикла;
	Возврат Связи;

КонецФункции

// Строка видна, если её выбрали сами или она нужна видимой отмеченной строке.
&НаКлиенте
Процедура ОтметитьВидимые(Связи)

	Для Каждого СтрокаСписка Из Строки Цикл
		СтрокаСписка.Виден = НЕ СтрокаСписка.Связанный;
	КонецЦикла;
	Изменилось = Истина;
	Пока Изменилось Цикл
		Изменилось = Ложь;
		Для Каждого СтрокаСписка Из Строки Цикл
			Если НЕ СтрокаСписка.Виден И НайтиНужнуюСвязь(СтрокаСписка, Связи) <> Неопределено Тогда
				СтрокаСписка.Виден = Истина;
				Изменилось = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция НайтиНужнуюСвязь(СтрокаСписка, Связи)

	Для Каждого Связь Из СтрРазделить(СтрокаСписка.Родители, ";", Ложь) Цикл
		Части = СтрРазделить(Связь, "|");
		Родитель = Связи[Части[0]];
		Если Родитель <> Неопределено И Родитель.Виден И Родитель.Отмечен Тогда
			Возврат Новый Структура("Родитель,ВДвижениях", Родитель, Части[1] = "1");
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

&НаКлиенте
Функция ТекстРезультата(СтрокаСписка, Связи)

	Если Записано Тогда
		Возврат ?(СтрокаСписка.Отмечен, "записано", "не переносился");
	КонецЕсли;

	Связь = НайтиНужнуюСвязь(СтрокаСписка, Связи);
	Владелец = "";
	Если Связь <> Неопределено Тогда
		Владелец = ?(Связь.ВДвижениях, "движениях ", "") + "«" + Связь.Родитель.Представление + "»";
	КонецЕсли;

	Если СтрокаСписка.Действие = "blocked" Тогда
		Текст = СтрокаСписка.Сообщение;
	ИначеЕсли СтрокаСписка.Действие = "broken" Тогда
		Текст = "нет и в этой базе: ссылка останется битой в " + Владелец;
	ИначеЕсли СтрокаСписка.Действие = "limit" Тогда
		Текст = "не проверен (лимит): будет битая ссылка в " + Владелец;
	ИначеЕсли НЕ СтрокаСписка.Отмечен Тогда
		Если СтрокаСписка.Связанный Тогда
			Текст = "не переносится: будет битая ссылка в " + Владелец;
		Иначе
			Текст = ?(СтрокаСписка.Действие = "unchanged", "без изменений", "не переносится");
		КонецЕсли;
	ИначеЕсли СтрокаСписка.Действие = "create" Тогда
		Текст = "будет создан";
	ИначеЕсли СтрокаСписка.Действие = "unchanged" Тогда
		Текст = "без изменений, будет перезаписан";
	Иначе
		Текст = "будет обновлён: " + СтрокаСписка.Изменения;
	КонецЕсли;

	Если СтрокаСписка.Отмечен И СтрокаСписка.Связанный И НЕ ПустаяСтрока(Владелец) Тогда
		Текст = Текст + " · нужен для " + Владелец;
	КонецЕсли;
	Возврат Текст;

КонецФункции

&НаКлиенте
Функция ОтступУровня(Уровень)

	Отступ = "";
	Для Шаг = 2 По Уровень Цикл
		Отступ = Отступ + "    ";
	КонецЦикла;
	Возврат Отступ;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция МожноОтметить(Действие)

	Возврат Действие <> "blocked" И Действие <> "broken" И Действие <> "limit";

КонецФункции

&НаСервереБезКонтекста
Функция СвязиСтрокой(Родители)

	Части = Новый Массив;
	Для Каждого Родитель Из Родители Цикл
		Части.Добавить(Родитель.Key + "|" + ?(Родитель.InMovements, "1", "0"));
	КонецЦикла;
	Возврат СтрСоединить(Части, ";");

КонецФункции

&НаСервере
Функция ПредставлениеВыбора()

	Если Выбор.Количество() = 1 Тогда
		Возврат Строка(Выбор[0].Значение);
	КонецЕсли;
