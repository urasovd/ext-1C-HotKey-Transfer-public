&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ ПравоДоступа("Администрирование", Метаданные) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Версия = WS_ОкружениеСервер.ВерсияРасширения();
	АдресРабочейБазы = WS_ОкружениеСервер.АдресРабочейБазы();
	Если WS_ОкружениеСервер.ПолучитьТипОкружения() = "production" Тогда
		ТипБазы = "рабочая: " + WS_ОкружениеСервер.ПолучитьИдентификатор();
		Пояснение = "Укажите адрес этой базы один раз. Копии из её бэкапа сразу предложат его как приёмник.";
	Иначе
		ТипБазы = "копия: " + WS_ОкружениеСервер.ПолучитьИдентификатор();
		Пояснение = "Обычно адрес и пароль приходят из бэкапа рабочей базы. Если их нет, укажите здесь: они сохранятся до следующего обновления копии. В рабочей базе перед этим должен быть включён приём.";
	КонецЕсли;
	ПоказатьСостояниеПриёма();

КонецПроцедуры

&НаКлиенте
Процедура СохранитьОбработка(Команда)

	СохранитьНаСервере();

КонецПроцедуры

// Сначала пароль: адрес проверяется обращением к базе с этим паролем.
&НаСервере
Процедура СохранитьНаСервере()

	Если НЕ ПустаяСтрока(ПарольВхода) Тогда
		Попытка
			WS_ОкружениеСервер.УстановитьПарольСлужебногоВхода(ПарольВхода);
		Исключение
			Состояние = "Пароль не сохранён. " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Возврат;
		КонецПопытки;
		ПарольВхода = "";
		Элементы.ПарольВхода.РежимПароля = Истина;
		ПоказатьСостояниеПриёма();
	КонецЕсли;

	АдресРабочейБазы = СокрЛП(АдресРабочейБазы);
	Ошибка = WS_ТранспортСервер.СохранитьАдресРабочейБазы(АдресРабочейБазы);
	Если НЕ ПустаяСтрока(Ошибка) Тогда
		Состояние = "Адрес не сохранён. " + Ошибка;
	ИначеЕсли ПустаяСтрока(АдресРабочейБазы) Тогда
		Состояние = "Сохранено. Адрес рабочей базы не указан.";
	Иначе
		Состояние = "Адрес проверен и сохранён.";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РазрешитьПриёмОбработка(Команда)

	РазрешитьПриёмНаСервере();

КонецПроцедуры

&НаСервере
Процедура РазрешитьПриёмНаСервере()

	WS_ОкружениеСервер.ВключитьПриём();
	ПоказатьСостояниеПриёма();
	Состояние = "Эта база теперь принимает переносы от пользователей с полными правами.";

КонецПроцедуры

// Пароль попадает на клиент только по этой команде: он нужен, чтобы ввести его в копии,
// созданной раньше, или в копии не из бэкапа этой базы.
&НаКлиенте
Процедура ПоказатьПарольОбработка(Команда)

	ПоказатьПарольНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПоказатьПарольНаСервере()

	ПарольВхода = WS_ОкружениеСервер.ПарольСлужебногоПользователя();
	Элементы.ПарольВхода.РежимПароля = Ложь;
	Состояние = ?(ПустаяСтрока(ПарольВхода), "Пароля пока нет.", "Не сохраняйте пароль в файлах и переписке.");

КонецПроцедуры

&НаКлиенте
Процедура НовыйПарольОбработка(Команда)

	ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОНовомПароле", ЭтотОбъект),
		"Создать новый пароль служебного входа? Базы со старым паролем не смогут подключаться к этой базе и принимать из неё данные, пока их не обновят из нового бэкапа или не укажут новый пароль.",
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОНовомПароле(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		НовыйПарольНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура НовыйПарольНаСервере()

	WS_ОкружениеСервер.СоздатьНовыйПарольСлужебногоВхода();
	ПарольВхода = "";
	Элементы.ПарольВхода.РежимПароля = Истина;
	ПоказатьСостояниеПриёма();
	Состояние = "Новый пароль создан. Копии получат его со следующим бэкапом.";

КонецПроцедуры

&НаСервере
Процедура ПоказатьСостояниеПриёма()

	Включён = WS_ОкружениеСервер.ПриёмВключён();
	Полностью = WS_ОкружениеСервер.ПриёмНастроенПолностью();
	ЕстьПароль = НЕ ПустаяСтрока(WS_ОкружениеСервер.ПарольСлужебногоПользователя());
	Если НЕ Включён Тогда
		СостояниеПриёма = "выключен в этой базе";
	ИначеЕсли НЕ Полностью Тогда
		СостояниеПриёма = "не работает: служебного пользователя нет в справочнике «Пользователи». Нажмите «Разрешить приём в эту базу»";
	ИначеЕсли ЕстьПароль Тогда
		СостояниеПриёма = "включён в этой базе";
	Иначе
		СостояниеПриёма = "включён в этой базе, но со старым общим паролем: нажмите «Новый пароль»";
	КонецЕсли;
	Элементы.РазрешитьПриём.Видимость = НЕ Полностью;
	Элементы.НовыйПароль.Видимость = Включён;

КонецПроцедуры
